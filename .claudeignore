# .claudeignore — files Claude Code should never load into context.
# Syntax is identical to .gitignore. See:
#   https://docs.anthropic.com/en/docs/claude-code/memory#claudeignore

# Version control
.git/

# OS metadata
.DS_Store
Thumbs.db

# IDE / editor state
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Environment files and secrets
.env
.env.*
*.pem
*.key
secrets/

# Dependency directories (language-specific — uncomment what applies)
# node_modules/
# vendor/
# .bundle/
# __pycache__/
# .venv/
# venv/
# target/         # Rust / Java
# .gradle/
# .m2/

# Lock files (large, low signal)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# Gemfile.lock
# poetry.lock
# Cargo.lock
# go.sum
# composer.lock

# Build output
build/
dist/
out/
target/
bin/
*.exe

# Test / coverage artifacts
coverage/
.nyc_output/
htmlcov/
*.lcov

# Binary and media files
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.eot
*.mp3
*.mp4
*.zip
*.tar.gz
*.tgz
*.jar
*.war
*.dll
*.so
*.dylib
*.pdf

# Temp files
/tmp/
*.tmp
*.bak
*.log
